    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "eslint": "^9.17.0",
    "fast-check": "^3.23.0",
    "tsup": "8.5.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
